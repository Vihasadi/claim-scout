# Copy to .env. Variables already set in your shell take precedence.

# Any OpenAI-compatible endpoint works. Ollama (free, local) is the default.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=unused
LLM_CONTEXT_TOKENS=32000
LLM_REPLY_TOKENS=1500
LLM_CONCURRENCY=4

# ClaimReplay's output (input here), and where playbooks go.
REPLAY_DB_PATH=../claim-replay/data/replays.sqlite3
PLAYBOOK_DB_PATH=data/playbooks.sqlite3

# Smallest segment that gets a playbook, and most deals the model reads per segment.
MIN_DEALS=3
SAMPLE_SIZE=24
